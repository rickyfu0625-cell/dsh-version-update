{
  "name": "dsh-version-update",
  "version": "1.0.0",
  "description": "DeepSeek Harness 版本与更新插件（永久）：在「设置 → 通用设置」显示当前版本，支持检查更新与一键更新，中英双语。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "version",
    "update",
    "check-update"
  ],
  "license": "MIT"
}
